":360.0},{"name":"DistanciaMinima","type":"number","value":20.0},{"name":"Duracion","type":"number","value":75.0},{"name":"DuracionFrase","type":"number","value":4.5},{"name":"FuerzaSalto","type":"number","value":900.0},{"name":"IntervaloFrases","type":"number","value":10.0},{"name":"ObstaculoMax","type":"number","value":2.2},{"name":"ObstaculoMin","type":"number","value":1.2},{"name":"PrimeraFrase","type":"number","value":5.0},{"name":"ProbBarro","type":"number","value":15.0},{"name":"ProbCharco","type":"number","value":25.0},{"name":"ProbPiedra","type":"number","value":40.0},{"name":"RecuperacionPorSegundo","type":"number","value":12.0},{"name":"SegundosLento","type":"number","value":0.7},{"name":"VelocidadJugadora","type":"number","value":400.0}]},{"name":"FrasesCulturales","type":"array","children":[{"type":"string","value":"Saraguro está a unos 2.500 metros de altura. ¡Por eso hace tanto frío!"},{"type":"string","value":"La minga es trabajar todos juntos, mancomunadamente, por el bien de la comunidad."},{"type":"string","value":"El pueblo Saraguro habla kichwa y español."},{"type":"string","value":"La vestimenta saraguro es negra y blanca. Las mujeres usan pollera, reboso, tupu y collares de mullos."},{"type":"string","value":"El sombrero tradicional es blanco y de ala ancha, hecho de lana."},{"type":"string","value":"Cada año hay cuatro Raymi: Pawkar en marzo, Inti en junio, Kulla en septiembre y Kapak en diciembre."},{"type":"string","value":"¡El Wiki es un personaje bromista de las fiestas de Navidad! Tiene dos caras y ropa de colores."},{"type":"string","value":"En el Inti Raymi se agradece al sol por las cosechas."},{"type":"string","value":"El maíz es un alimento sagrado y se comparte en las fiestas y en la minga."},{"type":"string","value":"Los Baños del Inca y la cascada Virgen Kaka son lugares muy queridos de Saraguro."},{"type":"string","value":"La pambamesa es una comida comunitaria: cada familia trae alimentos para compartir."},{"type":"string","value":"«Yupaychani» significa «gracias» en kichwa."}]},{"name":"PalabrasKichwa","type":"structure","children":[{"name":"Barro","type":"string","value":"¡Atatay!"},{"name":"Cerca","type":"string","value":"¡Kallpay, kallpay!"},{"name":"Charco","type":"string","value":"¡Achachay!"},{"name":"Inicio","type":"string","value":"¡Kallpay!"},{"name":"Meta","type":"string","value":"¡Yupaychani!"},{"name":"Niebla","type":"string","value":"¡Achachay!"},{"name":"Piedra","type":"string","value":"¡Ayayay!"}]},{"name":"TextosUI","type":"structure","children":[{"name":"BarraPeligro","type":"string","value":"Wiki"},{"name":"BotonJugar","type":"string","value":"JUGAR"},{"name":"BotonMenu","type":"string","value":"MENÚ"},{"name":"BotonReiniciar","type":"string","value":"VOLVER A CORRER"},{"name":"Creditos","type":"string","value":"Hecho en el taller de videojuegos de la Carrera de Computación, UNL. Arte, música y voces: ver CREDITOS.txt"},{"name":"Derrota","type":"string","value":"¡El Wiki te alcanzó! Inténtalo otra vez."},{"name":"Instrucciones","type":"string","value":"Salta con ESPACIO, la flecha arriba o tocando la pantalla. Esquiva piedras, charcos y nubes. ¡No dejes que el Wiki te alcance!"},{"name":"Pausa","type":"string","value":"PAUSA — presiona P para seguir"},{"name":"Subtitulo","type":"string","value":"Nivel 1: camino a la plaza"},{"name":"Tiempo","type":"string","value":"Tiempo: "},{"name":"Titulo","type":"string","value":"SARAGURO KALLPAY"},{"name":"Victoria","type":"string","value":"¡Llegaste a la plaza! Yupaychani por jugar."}]}],"layouts":[{"b":240,"disableInputWhenNotFocused":true,"mangledName":"Menu","name":"Menu","r":209,"renderer3DWorldScale":100.0,"standardSortMethod":true,"stopSoundsOnStartup":true,"title":"","v":229,"uiSettings":{},"objectsGroups":[],"variables":[],"instances":[{"angle":0.0,"customSize":false,"height":0.0,"keepRatio":true,"layer":"","name":"FondoMenu","persistentUuid":"e82df211-289a-4b5c-8e3c-df53ef9ada0f","width":0.0,"x":0.0,"y":0.0,"zOrder":0,"nu